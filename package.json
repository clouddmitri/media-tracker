{
  "name": "media-tracker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "dev": "pnpm --filter @media-tracker/api dev",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "db:migrate": "pnpm --filter @media-tracker/api db:migrate",
    "db:seed": "pnpm --filter @media-tracker/api db:seed",
    "db:reset": "pnpm --filter @media-tracker/api db:reset",
    "db:studio": "pnpm --filter @media-tracker/api db:studio",
    "postinstall": "pnpm --filter @media-tracker/api exec prisma generate",
    "test": "pnpm --filter @media-tracker/api exec vitest run",
    "test:unit": "pnpm --filter @media-tracker/api exec vitest run --project unit",
    "test:integration": "pnpm --filter @media-tracker/api exec vitest run --project integration",
    "test:watch": "pnpm --filter @media-tracker/api exec vitest --project unit",
    "test:coverage": "pnpm --filter @media-tracker/api exec vitest run --coverage"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "secretlint": "^13.0.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*": [
      "secretlint --maskSecrets"
    ]
  }
}
